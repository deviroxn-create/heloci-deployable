datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  APPLICANT
  STAFF
  ADMIN
}

enum NotificationDeliveryStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITLISTED
}

model User {
  createdOrganizations    Organization[]               @relation("CreatedOrganizations")
  id                      String                       @id @default(cuid())
  name                    String?
  email                   String                       @unique
  organizationId          String?
  role                    Role                         @default(APPLICANT)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  applications            Application[]
  programApplications     ProgramApplication[]
  assignedApplications    ProgramApplication[]         @relation("AssignedApplications")
  reviewedApplications    ProgramApplication[]         @relation("ReviewedApplications")
  applicantProfiles       ApplicantProfile[]
  documents               Document[]
  messages                Message[]                    @relation("sentMessages")
  received                Message[]                    @relation("receivedMessages")
  staffNotes              StaffNote[]
  notifications           Notification[]
  notificationLogs        NotificationLog[]
  notificationPreferences NotificationPreference[]
  communicationTimeline   CommunicationTimelineEntry[]
  applicationEvents       ApplicationEvent[]
  documentRequests        DocumentRequest[]
  auditLogs               AuditLog[]
  programRecommendations  ProgramRecommendation[]
  organization            Organization?                @relation(fields: [organizationId], references: [id])
  OrganizationMember      OrganizationMember[]
  sentInvitations         Invitation[]
  programsCreated         Program[]                    @relation("ProgramsCreated")
  programsArchived        Program[]                    @relation("ProgramsArchived")
  programEvents           ProgramEvent[]               @relation("ProgramEventActor")
  createdEligibilityRules EligibilityRule[]            @relation("EligibilityRuleCreator")
  documentReviews         DocumentRequest[]            @relation("DocumentReviews")
}

model Property {
  id                String          @id @default(cuid())
  externalId        String?         @unique // e.g. Zillow zpid or slug
  title             String
  description       String
  address           String
  city              String
  state             String
  zip               String?
  latitude          Float?
  longitude         Float?
  rent              Int // lowest unit price (cents omitted — stored as dollars)
  rentMax           Int? // highest unit price for range display
  bedrooms          Int // min bedrooms across units
  bathrooms         Int
  sqft              Int
  amenities         String[]
  specialOffers     String[]
  contactPhone      String?
  availabilityCount Int             @default(0)
  status            String          @default("AVAILABLE")
  units             PropertyUnit[]
  images            PropertyImage[]
  applications      Application[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model PropertyUnit {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  beds       Int
  price      Int // monthly rent in dollars
  available  Boolean  @default(true)
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  altText    String?
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
}

model ApplicantProfile {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String   @unique
  profileData  Json
  completeness Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Program {
  id                     String                  @id @default(cuid())
  organizationId         String
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                   String
  slug                   String                  @unique
  housingGoal            String
  status                 String                  @default("draft")
  isArchived             Boolean                 @default(false)
  publishedAt            DateTime?
  requiredDocuments      Json?
  summary                String?                 @db.Text
  maxApplicants          Int?
  createdBy              String
  archivedAt             DateTime?
  archivedBy             String?
  eligibilitySummary     String?
  description            String?
  priority               Int                     @default(0)
  category               String?
  deadline               DateTime?
  isPublic               Boolean                 @default(true)
  matchDescription       String?
  workflowTriggers       WorkflowTrigger[]
  waitlist               WaitlistEntry[]
  maxWaitlistSize        Int?
  decisionSlaDays        Int                     @default(14)
  documentSlaDays        Int                     @default(7)
  autoAssignReviewers    Boolean                 @default(false)
  eligibilityRules       EligibilityRule[]
  eligibilityResults     EligibilityResult[]
  questionSets           QuestionSet[]
  programApplications    ProgramApplication[]
  programRecommendations ProgramRecommendation[]
  programEvents          ProgramEvent[]          @relation("ProgramEventProgram")
  createdByUser          User                    @relation("ProgramsCreated", fields: [createdBy], references: [id])
  archivedByUser         User?                   @relation("ProgramsArchived", fields: [archivedBy], references: [id])
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model ProgramEvent {
  id        String   @id @default(cuid())
  programId String
  type      String
  actorId   String
  metadata  Json?
  createdAt DateTime @default(now())
  program   Program  @relation("ProgramEventProgram", fields: [programId], references: [id], onDelete: Cascade)
  actor     User     @relation("ProgramEventActor", fields: [actorId], references: [id])

  @@index([programId, createdAt])
}

model Organization {
  id                String               @id @default(cuid())
  name              String
  slug              String               @unique
  description       String?
  logoUrl           String?
  website           String?
  emailFromName     String?              @default("Heloci")
  telegramChannelId String?
  createdBy         String
  isActive          Boolean              @default(true)
  programs          Program[]
  members           OrganizationMember[]
  users             User[]
  createdAt         DateTime             @default(now())
  creator           User                 @relation("CreatedOrganizations", fields: [createdBy], references: [id])
  invitations       Invitation[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String
  token          String       @unique
  invitedBy      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation(fields: [invitedBy], references: [id])

  @@unique([organizationId, email])
  @@index([token])
}

model EligibilityRule {
  id            String   @id @default(cuid())
  programId     String
  version       Int      @default(1)
  name          String   @default("v1")
  rules         Json
  explanation   String?
  explanationNo String?
  weight        Int      @default(1)
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  program       Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  creator       User     @relation("EligibilityRuleCreator", fields: [createdBy], references: [id])

  @@index([programId, isActive])
}

model QuestionSet {
  id        String   @id @default(cuid())
  programId String
  name      String   @default("Application Form")
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  pages     Page[]

  @@unique([programId, version])
  @@index([programId, isActive])
}

model Page {
  id            String      @id @default(cuid())
  questionSetId String
  title         String
  description   String?
  sortOrder     Int
  questionSet   QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  questions     Question[]

  @@index([questionSetId, sortOrder])
}

model Question {
  id             String              @id @default(cuid())
  pageId         String
  key            String
  label          String
  type           String
  description    String?
  placeholder    String?
  required       Boolean             @default(false)
  options        Json?
  validation     Json?
  conditional    Json?
  profileMapping String?
  order          Int                 @default(0)
  page           Int                 @default(0)
  section        String?
  createdAt      DateTime            @default(now())
  helpText       String?
  optionsRaw     Json?
  validationRaw  Json?
  isUniversal    Boolean             @default(false)
  profileField   String?
  pageRelation   Page                @relation(fields: [pageId], references: [id], onDelete: Cascade)
  conditions     QuestionCondition[]

  @@unique([pageId, key])
  @@index([pageId, order])
}

model QuestionCondition {
  id         String   @id @default(cuid())
  questionId String
  type       String
  rules      Json
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model EligibilityResult {
  id          String    @id @default(cuid())
  userId      String
  programId   String
  isEligible  Boolean
  score       Int?
  reason      Json
  ruleVersion Int
  needsReview Boolean   @default(false)
  matchedAt   DateTime  @default(now())
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  program     Program   @relation(fields: [programId], references: [id])

  @@unique([userId, programId])
  @@index([userId])
}

model ProgramRecommendation {
  id            String   @id @default(cuid())
  userId        String
  programId     String
  type          String
  reason        String
  missingFields Json?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
  program       Program  @relation(fields: [programId], references: [id])

  @@unique([userId, programId, type])
  @@index([userId, type])
}

model Application {
  id                 String              @id @default(cuid())
  applicant          User                @relation(fields: [applicantId], references: [id])
  applicantId        String
  property           Property?           @relation(fields: [propertyId], references: [id])
  propertyId         String?
  status             ApplicationStatus   @default(PENDING)
  income             Int?
  householdSize      Int?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  documents          Document[]
  messages           Message[]
  eligibilityProfile EligibilityProfile?
  staffNotes         StaffNote[]
}

model ProgramApplication {
  id               String             @id @default(cuid())
  userId           String
  programId        String
  status           String             @default("draft")
  data             Json               @default("{}")
  currentPage      Int                @default(0)
  submittedAt      DateTime?
  deadline         DateTime?
  waitlistedAt     DateTime?
  slaBreachedAt    DateTime?
  assignedToId     String?
  assignedAt       DateTime?
  reviewedById     String?
  reviewedAt       DateTime?
  decision         String?
  decisionReason   String?
  internalNotes    String?            @db.Text
  lastActivityAt   DateTime           @default(now()) @updatedAt
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id])
  program          Program            @relation(fields: [programId], references: [id])
  assignedTo       User?              @relation("AssignedApplications", fields: [assignedToId], references: [id])
  reviewedBy       User?              @relation("ReviewedApplications", fields: [reviewedById], references: [id])
  events           ApplicationEvent[]
  documentRequests DocumentRequest[]
  waitlistEntry    WaitlistEntry?

  @@unique([userId, programId])
  @@index([userId, status])
  @@index([programId, status])
  @@index([assignedToId])
}

model ApplicationEvent {
  id            String             @id @default(cuid())
  applicationId String
  type          String
  actorId       String
  fromStatus    String?
  toStatus      String?
  metadata      Json?
  createdAt     DateTime           @default(now())
  application   ProgramApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor         User               @relation(fields: [actorId], references: [id])

  @@index([applicationId, createdAt])
}

model DocumentRequest {
  id              String             @id @default(cuid())
  applicationId   String
  documentType    String
  status          String             @default("pending")
  requestedBy     String
  requestedAt     DateTime           @default(now())
  expiresAt       DateTime?
  reminderSentAt  DateTime?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?
  autoExpired     Boolean            @default(false)
  fileUrl         String?
  notes           String?
  application     ProgramApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requestedByUser User               @relation(fields: [requestedBy], references: [id])
  reviewer        User?              @relation("DocumentReviews", fields: [reviewedBy], references: [id])

  @@index([applicationId, status])
}

model WorkflowTrigger {
  id           String   @id @default(cuid())
  programId    String
  name         String
  event        String
  condition    Json?
  action       String
  actionConfig Json
  isActive     Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  program      Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, event, isActive])
}

model WaitlistEntry {
  id            String             @id @default(cuid())
  programId     String
  applicationId String             @unique
  position      Int
  joinedAt      DateTime           @default(now())
  promotedAt    DateTime?
  removedAt     DateTime?
  removeReason  String?
  program       Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  application   ProgramApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([programId, position, promotedAt])
}

model Document {
  id            String      @id @default(cuid())
  fileName      String
  fileUrl       String
  type          String
  uploadedAt    DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id])
  applicationId String
  uploader      User        @relation(fields: [uploaderId], references: [id])
  uploaderId    String
}

model Message {
  id            String       @id @default(cuid())
  sender        User         @relation("sentMessages", fields: [senderId], references: [id])
  senderId      String
  recipient     User         @relation("receivedMessages", fields: [recipientId], references: [id])
  recipientId   String
  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?
  content       String
  createdAt     DateTime     @default(now())
  read          Boolean      @default(false)
}

model EligibilityProfile {
  id              String      @id @default(cuid())
  application     Application @relation(fields: [applicationId], references: [id])
  applicationId   String      @unique
  score           Int?
  status          String
  recommendations String[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model StaffNote {
  id            String      @id @default(cuid())
  author        User        @relation(fields: [authorId], references: [id])
  authorId      String
  application   Application @relation(fields: [applicationId], references: [id])
  applicationId String
  content       String
  createdAt     DateTime    @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  body      String
  category  String
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NotificationLog {
  id               String                     @id @default(cuid())
  eventName        String
  channel          String
  recipient        String?
  sender           String?
  subject          String?
  messagePreview   String?
  templateUsed     String?
  payload          Json?
  provider         String?
  providerResponse Json?
  deliveryStatus   NotificationDeliveryStatus @default(PENDING)
  retryCount       Int                        @default(0)
  maxRetries       Int                        @default(5)
  nextRetryAt      DateTime?
  errorMessage     String?
  createdAt        DateTime                   @default(now())
  sentAt           DateTime?
  deliveredAt      DateTime?
  readAt           DateTime?
  user             User?                      @relation(fields: [userId], references: [id])
  userId           String?
  retryAttempts    NotificationRetryAttempt[]
}

enum NotificationTemplateStatus {
  DRAFT
  PUBLISHED
}

model CommunicationSettings {
  id               String   @id @default("default")
  enabled          Boolean  @default(true)
  channels         Json     @default("{}")
  senderEmail      String   @default("support@heloci.ngo")
  telegramBotToken String?
  telegramChatId   String?
  events           Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model NotificationTemplate {
  id        String                     @id @default(cuid())
  name      String
  eventName String
  channel   String
  locale    String                     @default("en")
  title     String
  subject   String
  html      String
  plainText String
  variables Json?
  status    NotificationTemplateStatus @default(PUBLISHED)
  active    Boolean                    @default(true)
  version   Int                        @default(1)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
}

model NotificationRetryAttempt {
  id                String                     @id @default(cuid())
  notificationLog   NotificationLog            @relation(fields: [notificationLogId], references: [id])
  notificationLogId String
  attempt           Int
  status            NotificationDeliveryStatus
  errorMessage      String?
  providerResponse  Json?
  createdAt         DateTime                   @default(now())
}

model NotificationPreference {
  id        String   @id @default(cuid())
  scopeType String   @default("GLOBAL")
  scopeId   String?
  userId    String?
  eventName String
  channel   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
}

model CommunicationTimelineEntry {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  eventName String
  title     String
  details   String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  entity    String
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}
