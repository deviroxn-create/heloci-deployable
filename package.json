{
  "name": "heloci",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "db:generate": "prisma generate",
    "db:seed": "npm run db:generate && npx tsc prisma/seed.ts --esModuleInterop --module commonjs --target es2020 --outDir prisma && node prisma/seed.js",
    "test": "node scripts/run-tests.cjs",
    "test:e2e": "npx playwright test tests/e2e --config tests/e2e/playwright.config.ts",
    "test:k2": "node scripts/run-tests.cjs tests/k2-*.test.ts"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
